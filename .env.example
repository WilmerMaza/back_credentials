DATABASE_URL="postgresql://user:password@postgres_server:5432/credencial_db"
API_KEY=""
PORT=3000
UPLOADS_DIR="uploads/credentials"
JWT_SECRET=""
JWT_ACCESS_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7
NODE_ENV="development"

# Prefijo público del API visto por el navegador (cookie refresh Path).
# Obligatorio `/api` con Docker o `ng serve` + proxy. Vacío solo si el API se consume en la raíz.
API_PUBLIC_PREFIX=/api

# ── Cookies HttpOnly ──────────────────────────────────────────────────────────
# lax = mismo origen vía /api (Docker o ng serve con proxy)
AUTH_COOKIE_SAMESITE=lax
AUTH_COOKIE_DOMAIN=

# ── Sin certificado SSL (HTTP :80) — estado actual local/servidor ─────────────
AUTH_COOKIE_SECURE=false
# PUBLIC_APP_URL=https://credenciales.enap.edu.co
# CORS_ORIGINS=http://credenciales.enap.edu.co,http://credenciales.enap

# ── Con certificado SSL (HTTPS) — ver docs/SSL_CERTIFICATE.md ────────────────
# AUTH_COOKIE_SECURE=true
# PUBLIC_APP_URL=https://credenciales.enap.edu.co
# CORS_ORIGINS=https://credenciales.enap.edu.co,https://credenciales.enap

# CSRF double-submit (activo por defecto; false solo para depuración local)
CSRF_ENABLED=true

# IDs de usuario admin (separados por coma) para gestionar sesiones ajenas
ADMIN_USER_IDS=

# Azure AD + Microsoft Graph (Exchange Online)
AZURE_TENANT_ID=""
AZURE_CLIENT_ID=""
AZURE_CLIENT_SECRET=""
AZURE_SENDER_EMAIL=""
MAIL_FROM_NAME="Credencial Digital"
MAX_PDF_SIZE_MB=25

# Rate limiting (peticiones por IP por ventana THROTTLE_TTL en ms)
THROTTLE_TTL=60000
THROTTLE_LIMIT=120
THROTTLE_AUTH_TTL=60000
THROTTLE_AUTH_LIMIT=10
THROTTLE_WRITE_TTL=60000
THROTTLE_WRITE_LIMIT=30
THROTTLE_MAIL_TTL=60000
THROTTLE_MAIL_LIMIT=10
