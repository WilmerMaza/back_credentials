DATABASE_URL="postgresql://user:password@localhost:5432/credencial_db"
API_KEY=""
PORT=3000
UPLOADS_DIR="uploads/credentials"
JWT_SECRET=""
JWT_ACCESS_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7
NODE_ENV="development"

# Cookies HttpOnly
# lax  = mismo origen vía proxy /api (recomendado en DEV con proxy Angular)
# none = solo si front y API son orígenes distintos (requiere AUTH_COOKIE_SECURE=true)
AUTH_COOKIE_SAMESITE=lax
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_DOMAIN=

# Producción (credenciales.enap.edu.co)
# PUBLIC_APP_URL=https://credenciales.enap.edu.co
# CORS_ORIGINS=https://credenciales.enap.edu.co
# AUTH_COOKIE_SAMESITE=lax
# AUTH_COOKIE_SECURE=true

# CSRF double-submit (activo por defecto; false solo para depuración local)
CSRF_ENABLED=true

# IDs de usuario admin (separados por coma) para gestionar sesiones ajenas
ADMIN_USER_IDS=

# Azure AD + Microsoft Graph (Exchange Online)
AZURE_TENANT_ID=""
AZURE_CLIENT_ID=""
AZURE_CLIENT_SECRET=""
AZURE_SENDER_EMAIL=""
MAIL_FROM_NAME="Credencial Digital"
MAX_PDF_SIZE_MB=25

# Rate limiting (peticiones por IP por ventana THROTTLE_TTL en ms)
THROTTLE_TTL=60000
THROTTLE_LIMIT=120
THROTTLE_AUTH_TTL=60000
THROTTLE_AUTH_LIMIT=10
THROTTLE_WRITE_TTL=60000
THROTTLE_WRITE_LIMIT=30
THROTTLE_MAIL_TTL=60000
THROTTLE_MAIL_LIMIT=10
